            ],
            "commands": [
                "extension.changeCase.snake"
            ]
        },
        {
            "before": [
                "leader",
                "c",
                "c"
            ],
            "commands": [
                "extension.changeCase.camel"
            ]
        },
        {
            "before": [
                "leader",
                "w"
            ],
            "after": [
                "leader",
                "leader",
                "w"
            ]
        },
        {
            "before": [
                "leader",
                "b"
            ],
            "after": [
                "leader",
                "leader",
                "b"
            ]
        },
        {
            "before": [
                "leader",
                "e"
            ],
            "after": [
                "leader",
                "leader",
                "b"
            ]
        },
        {
            "before": [
                "u"
            ],
            "commands": [
                "undo"
            ]
        },
        {
            "before": [
                "<C-r>"
            ],
            "commands": [
                "redo"
            ]
        },
        {
            "before": [
                "leader",
                "r"
            ],
            "commands": [
                "actions.find",
                "editor.action.startFindReplaceAction"
            ]
        },
        {
            "before": [
                "*"
            ],
            "commands": [
                "actions.find",
                "workbench.action.focusActiveEditorGroup"
            ]
        },
        {
            "before": [
                "leader",
                "F"
            ],
            "commands": [
                "actions.find"
            ]
        },
        {
            "before": [
                "leader",
                "f"
