            "commands": [
                "actions.find"
            ]
        },
        {
            "before": [
                "/"
            ],
            "commands": [
                "actions.find"
            ]
        },
        {
            "before": [
                "n"
            ],
            "commands": [
                "extension.vim_escape",
                "editor.action.nextMatchFindAction",
                "extension.vim_escape"
            ]
        },
        {
            "before": [
                "N"
            ],
            "commands": [
                "extension.vim_escape",
                "editor.action.previousMatchFindAction",
                "extension.vim_escape"
            ]
        },
        {
            "before": [
                "<BS>"
            ],
            "commands": [
                ":nohl",
                "closeFindWidget"
            ]
        },
        {
            "before": [
                "g",
                "r"
            ],
            "commands": [
                "editor.action.referenceSearch.trigger"
            ]
        },
        {
            "before": [
                "K"
            ],
            "after": [
                "5",
                "k"
            ]
        },
        {
            "before": [
                "J"
            ],
            "after": [
                "5",
                "j"
            ]
        },
        {
            "before": [
                "leader",
