let mapleader = " "
" https://towardsdatascience.com/the-essential-ideavim-remaps-291d4cd3971b

" Plugins
set easymotion
map ;j <Plug>(easymotion-j)
map ;k <Plug>(easymotion-k)
map ;w <Plug>(easymotion-w)
map ;W <Plug>(easymotion-W)
map ;b <Plug>(easymotion-b)
map ;B <Plug>(easymotion-B)
map ;e <Plug>(easymotion-e)
map ;E <Plug>(easymotion-E)
map ;f <Plug>(easymotion-f)
map ;n <Plug>(easymotion-n)
map ;N <Plug>(easymotion-N)
map ;s <Plug>(easymotion-s)
map ;f <Plug>(easymotion-jumptoanywhere)

set surround
" ysiw<char>, ds<char> cs<from><to>"

set multiple-cursors

set commentary

set ideajoin
nmap <C-m><C-d> <Action>(EditorJoinLines)
" nmap <C-m><C-s> <Action>(EditorSplitLine)
"
" set switch
" nnoremap <leader>x :Switch<CR>
" nnoremap <leader>X :SwitchReverse<CR>
" let g:switch_definitions = 'group:basic,group:java,group:rspec'
"
" set highlightedyan
" let g:highlightedyank_highlight_duration = "200"
" let g:highlightedyank_highlight_color = "rgba(240, 240, 160, 40)"
"
" set NERDTree
let g:NERDTreeMapActivateNode='l'
let g:NERDTreeMapJumpParent='h'

" set which-key
" End of Plugins

packadd matchit

set showmode
set showcmd
set matchpairs
set smartcase
set ignorecase
set viminfo
set hlsearch
set incsearch
set scrolloff=4                         " show at least 4 lines above or under cursor
set sidescrolloff=5
set idearefactormode=keep
set clipboard+=unnamedplus              " use system clipboard
set visualbell
set noerrorbells

map <leader>h ^
map <leader>l $

inoremap jk <esc>
nnoremap K 5k
nnoremap J 5j
vnoremap K 5k
vnoremap J 5j
nnoremap / /\V
nnoremap ? /
nnoremap <Bs> :noh<CR>
nnoremap <C-]> g]
nnoremap g] <C-]>
vnoremap * y<Esc>/<C-r>"
nmap gj yygccp
vmap gj ygvgcgv<esc>p

" sort selected lines
vnoremap <C-m><C-s> :action EditorSortLines<CR>

nnoremap <leader>K :action ShowHoverInfo<CR>

" replace selected word in file
nnoremap <leader>r \"zyiw:%s/\V<C-r>z//g<Left><Left>
vnoremap <leader>r \"zy:%s/\V<C-r>z//g<Left><Left>

nnoremap <leader>R \"zyiw:%s/\V<C-r>z/<C-r>"/g<Left><Left>
vnoremap <leader>R \"zy:%s/\V<C-r>z/<C-r>"/g<Left><Left>
" split and merge lines
nnoremap <leader>j i<CR><Esc>
nnoremap <leader>k <esc>kJ

nnoremap <leader>fi :set lazyredraw<CR>:g/it '/normal za<CR>:g/it "/normal za<CR>:g/def /normal za<CR>:g/def /let za<CR>:set nolazyredraw<CR>
nnoremap <leader>fd :set lazyredraw<CR>:g/def /normal za<CR>:set nolazyredraw<CR>

" always focus after cursor jump
nnoremap <C-o> <C-o>zz
nnoremap <C-i> <C-i>zz
nnoremap gi gi<ESC>zza
nnoremap g; g;zz
nnoremap `` ``zz

" move block of code without losing selection
vnoremap > >gv
vnoremap < <gv
vnoremap <Tab> >gv
vnoremap <S-Tab> <gv

" Window movement
nnoremap <M-h> <C-w>h
nnoremap <M-j> <C-w>j
nnoremap <M-k> <C-w>k
nnoremap <M-l> <C-w>l
nnoremap <D-h> <C-w>h
nnoremap <D-j> <C-w>j
nnoremap <D-k> <C-w>k
nnoremap <D-l> <C-w>l

" file movement
nnoremap ]e :action GotoNextError<CR>
nnoremap [e :action GotoPreviousError<CR>
nnoremap ]g :action VcsShowNextChangeMarker<CR>
nnoremap [g :action VcsShowPrevChangeMarker<CR>
nnoremap ]f :action MethodDown<CR>
nnoremap [f :action MethodUp<CR>
nnoremap ]b :action GotoNextBookmarkInEditor<CR>
nnoremap [b :action GotoPreviousBookmarkInEditor<CR>

" Tabs
nnoremap <leader>1 :action GoToTab1<CR>
nnoremap <leader>2 :action GoToTab2<CR>
nnoremap <leader>3 :action GoToTab3<CR>
nnoremap <leader>4 :action GoToTab4<CR>
nnoremap <leader>5 :action GoToTab6<CR>
nnoremap <leader>6 :action GoToTab6<CR>
nnoremap <leader>7 :action GoToTab7<CR>
nnoremap <leader>8 :action GoToTab8<CR>
nnoremap <leader>9 :action GoToTab9<CR>
nnoremap <leader>w :action CloseContent<CR>

" Multiple cursors
lnoremap <M-k> :action EditorCloneCaretAbove<CR>
nnoremap <M-j> :action EditorCloneCaretBelow<CR>
nmap <C-n> <Plug>NextWholeOccurrence
xmap <C-n> <Plug>NextWholeOccurrence
nmap g<C-n> <Plug>NextOccurrence
xmap g<C-n> <Plug>NextOccurrence
nmap <C-x> <Plug>SkipOccurrence
xmap <C-x> <Plug>SkipOccurrence
nmap <C-p> <Plug>RemoveOccurrence
xmap <C-p> <Plug>RemoveOccurrence

" Fuzzy
nnoremap <C-p><C-p> :action GotoFile<CR>
nnoremap <leader>pp :action GotoFile<CR>
nnoremap <C-p><C-r> :action RecentFiles<CR>
nnoremap <leader>pr :action RecentFiles<CR>
nnoremap <leader>pu :action RecentChanges<CR>
nnoremap <leader>ps :action FileStructurePopup<CR>
nnoremap <C-p><C-s> :action FileStructurePopup<CR>
nnoremap <leader>pg :action ActivateCommitToolWindow<CR>
nnoremap <leader>pB :action Git.Branches<CR>
nnoremap <leader>pb :action ShowBookmarks<CR>

" Bookmarks
nnoremap <leader>mb :action ToggleBookmark<CR>

" Code Actions
nnoremap <leader>ca :action ShowIntentionActions<CR>
nnoremap <C-m><C-m> :action CodeMenu<CR>
nnoremap <C-m><C-r> :action Refactorings.QuickListPopupAction<CR>
nnoremap <C-m><C-f> :action ReformatCode<CR>
nnoremap <C-m><C-i> :action OptimizeImports<CR>
nnoremap <leader>a :action GotoTest<CR>
nnoremap <leader>e :action GotoRelated<CR>
nnoremap <C-m><C-g> :action Generate<CR>
nnoremap gr :action FindUsages<CR>
nnoremap gd :action GotoDeclaration<CR>
nnoremap gS :action GotoSuperMethod<CR>
nnoremap gV :action org.jetbrains.plugins.ruby.rails.actions.navigation.SwitchToView<CR>
nnoremap <leader>gh :action QuickImplementations<CR>
nnoremap <C-g><C-d> :action Compare.SameVersion<CR>

" Folds
nnoremap za :action ExpandCollapseToggleAction<CR>

" Copy relative path with line line_number
nnoremap <leader>cp :action CopyPathWithLineNumber<CR>
nnoremap <leader>y :action CopyReference<CR>
vnoremap <leader>y :action CopyReference<CR>

" Splitjoin
nnoremap <C-m><C-s> :action Splitjoin.Split<CR>
nnoremap <C-m><C-d> :action Splitjoin.Join<CR>

" Tests

" Panes
nnoremap <leader><esc> :action HideAllWindows<CR>
nnoremap <C-l><C-e> :action ActivateProblemsViewToolWindow<CR>
nnoremap <C-g><C-b> :action Annotate<CR>
nnoremap <C-k><C-u> :action LocalHistory.ShowHistory<CR>
nnoremap <C-p><C-b> :action Git.Branches<CR>

nnoremap \e :e ~/.ideavimrc<CR>
nnoremap \r :action IdeaVim.ReloadVimRc.reload<CR>
nnoremap <C-w>w :action MoveEditorToOppositeTabGroup<CR>
nnoremap <Leader>q :action CloseContent<CR>

nnoremap <C-q><C-r> :action RestartIde<CR>

